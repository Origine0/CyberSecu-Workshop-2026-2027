    {
      "type": "stat",
      "title": "Détection ML (Isolation Forest)",
      "description": "Verdict du modèle sur les 30 dernières secondes de trafic",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ml_anomaly",
          "legendFormat": "",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Normal",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "ANOMALIE",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4

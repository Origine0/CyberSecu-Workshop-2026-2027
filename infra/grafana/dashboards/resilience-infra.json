      "title": "Journal de la remédiation (alerte → décision → playbook → résultat)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"ml-detector|remediation\"} | json | step=~\"alert_sent|accepted|start|end|skipped|refused\" | line_format \"{{.event}} | {{.step}} | {{.type}} {{.action}} | {{.result}} {{.reason}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },

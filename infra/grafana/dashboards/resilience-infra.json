    {
      "id": 22,
      "type": "state-timeline",
      "title": "Chaîne automatique : anomalie détectée et service en panne",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Rouge en haut = le modèle voit une anomalie ; rouge en bas = un service est arrêté. Les deux repassent au vert sans intervention.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(ml_anomaly)",
          "legendFormat": "Anomalie détectée (ML)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - min(docker_container_healthy{service=~\"payment-api|waf|auth|frontend\"})",
          "legendFormat": "Service en panne"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "KO",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      }
    },
